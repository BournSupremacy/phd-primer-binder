logs/*.out
logs/*.err

# keep placeholders
!data/demux/.gitkeep
!results/.gitkeep
!logs/.gitkeep

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
analysis/*_cache/
analysis/*_files/

# misc
.DS_Store
*.log
__pycache__/
*.pyc
